  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "@fontsource/archivo-black": "5.2.5",
    "@fontsource/public-sans": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5"
  }
}
